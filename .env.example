# Static export inlines these at build time, so a missing value fails the build
# rather than the request. Copy to .env.local and fill in.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public by design and safe in the client bundle — it is subject to RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# There is deliberately no service role key here. It bypasses RLS entirely, so it
# must never reach the client. If something genuinely needs it, that something is a
# Supabase Edge Function.
