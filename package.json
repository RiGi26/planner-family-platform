{
  "name": "masume",
  "version": "0.1.0",
  "private": true,
  "description": "JLPT certification planner — counts backwards from the exam date to a daily quota, then runs that quota through a single FSRS engine.",
  "license": "MIT",
  "scripts": {
    "prebuild": "node scripts/fetch-kanjivg.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:strokes": "node scripts/verify-stroke-counts.mjs",
    "verify:fonts": "node scripts/verify-fonts.mjs",
    "kvg": "node scripts/fetch-kanjivg.mjs",
    "kana": "node scripts/generate-kana.mjs",
    "fonts": "node scripts/subset-fonts.mjs",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "5.101.4",
    "date-fns": "4.4.0",
    "dexie": "4.4.4",
    "dexie-react-hooks": "^1.1.7",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ts-fsrs": "5.4.1"
  },
  "devDependencies": {
    "@serwist/next": "9.5.12",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.0",
    "fake-indexeddb": "^6.2.5",
    "serwist": "9.5.12",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
